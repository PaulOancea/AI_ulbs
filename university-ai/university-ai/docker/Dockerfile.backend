# ──────────────────────────────────────────────────────────────────────────────
#  Dockerfile.backend — imaginea FastAPI + RAG
# ──────────────────────────────────────────────────────────────────────────────

FROM python:3.11-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Dependențe sistem necesare pentru PDF + sentence-transformers
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libgomp1 \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Instalăm dependențele Python (pe layer separat pentru cache)
COPY requirements.txt .
RUN pip install --upgrade pip && pip install -r requirements.txt

# Pre-descărcăm modelele de embeddings + reranker pentru a evita
# descărcarea la prima cerere (face imaginea mai mare dar pornește instant)
RUN python -c "from sentence_transformers import SentenceTransformer, CrossEncoder; \
    SentenceTransformer('paraphrase-multilingual-mpnet-base-v2'); \
    CrossEncoder('BAAI/bge-reranker-v2-m3')"

# Cod sursă
COPY backend/ ./backend/

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
