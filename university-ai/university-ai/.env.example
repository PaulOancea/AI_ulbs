# ──────────────────────────────────────────────────────────────────────────────
#  Configurație AI Universitar — copiază acest fișier în .env și ajustează
# ──────────────────────────────────────────────────────────────────────────────

# ── Ollama (LLM local) ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=180

# Temperatură scăzută → răspunsuri factuale, fără halucinații
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.9
OLLAMA_NUM_PREDICT=2000
OLLAMA_REPEAT_PENALTY=1.1

# ── Embeddings (multilingv, optimizat pentru RO) ──────────────────────────────
EMBED_MODEL=paraphrase-multilingual-mpnet-base-v2
EMBED_DEVICE=cpu

# Mod offline Hugging Face: implicit ACTIV (modelele rulează din cache-ul local,
# fără a contacta Hugging Face Hub la pornire). Setează pe 0 DOAR la prima rulare
# sau când vrei să descarci un model nou (necesită internet).
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ── Reranker (cross-encoder pentru acuratețe maximă) ──────────────────────────
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_N=5
RERANKER_ENABLED=true

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_PATH=./data/chroma_db
COLLECTION_NAME=university_docs

# ── Chunking inteligent ───────────────────────────────────────────────────────
CHUNK_SIZE=900
CHUNK_OVERLAP=150
CHUNK_LEGAL_AWARE=true

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=20          # câte rezultate brute (dense + bm25)
FINAL_TOP_K=5               # câte ajung la LLM după rerank
MIN_SCORE=0.20
HYBRID_ALPHA=0.5            # 0=BM25 pur, 1=dense pur, 0.5=echilibrat

# ── Memorie conversațională ───────────────────────────────────────────────────
MEMORY_WINDOW=6             # ultimele 6 schimburi (12 mesaje)
MEMORY_ENABLED=true

# ── Loguri ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./data/logs
LOG_RETENTION_DAYS=14

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# ── Folder documente ──────────────────────────────────────────────────────────
DOCS_FOLDER=./documente

# ── OCR (PDF-uri scanate + imagini PNG/JPG/TIFF) ──────────────────────────────
OCR_ENABLED=true
OCR_LANGUAGES=ron+eng              # limbi Tesseract: ron, eng, fra, deu, etc.
OCR_DPI=300                         # rezoluție rasterizare PDF (300 = bun)
OCR_MIN_TEXT_THRESHOLD=50           # sub atâtea caractere → OCR auto
# Cale spre binarul Tesseract (gol = caut în PATH).
# Windows tipic: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# ── Autentificare + istoric chat ──────────────────────────────────────────────
AUTH_ENABLED=true
DATABASE_PATH=./data/app.db
GUEST_QUESTION_LIMIT=3              # întrebări permise fără cont
PASSWORD_MIN_LENGTH=6
SESSION_SECRET=change-me-in-production-please-very-secret

# ── Orar (modul separat; rulează `python -m scripts.sync_schedule` ca să descarci) ──
SCHEDULE_FACULTY=ing
SCHEDULE_PLANNING_TIME_UNIT_ID=5
DEFAULT_SCHEDULE_FORMATION_ID=541
# Grupa/semigrupa implicită (folosită când întrebarea NU specifică o grupă)
DEFAULT_SCHEDULE_GROUP=C_31
DEFAULT_SCHEDULE_SUBGROUP=1
# Toate formațiile (grupe/semigrupe) de descărcat — vezi data/schedule/formation_map.json
#   C_31: 541,542,543 · C_32: 544,545,546 · TI_31: 557,558 · ISM_31: 564,565
SCHEDULE_FORMATION_IDS=541,542,543,544,545,546,557,558,564,565

# ── Examene (modul separat; ULBS Connect; rulează `python -m scripts.sync_exams`) ──
EXAMS_API_URL=https://connect.ulbsibiu.ro/api/schedule/faculties/ing/exams
EXAMS_FACULTY=ing
EXAMS_PLANNING_TIME_UNIT_ID=5
EXAMS_START_DATE=2026-03-02
EXAMS_END_DATE=2026-09-30
EXAMS_PER_PAGE=300
EXAMS_STUDY_FORMATIONS=C_31,C_32,TI_31,ISM_31
